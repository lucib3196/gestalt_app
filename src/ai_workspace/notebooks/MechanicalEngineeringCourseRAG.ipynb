   "source": [
    "from langgraph.graph import START, StateGraph\n",
    "from typing_extensions import List, TypedDict\n",
    "from langchain_core.documents import Document\n",
    "from langchain_core.prompts import ChatPromptTemplate\n",
    "from langchain import hub\n",
    "from langchain_openai import ChatOpenAI\n",
    "from langchain_core.prompts import PromptTemplate\n",
    "\n",
    "\n",
    "prompt  = PromptTemplate.from_template(\"\"\"\n",
    "You are an expert assistant specializing in answering questions about University of California Riverside Mechanical Engineering courses. You have full access to the official course catalog documentation.\n",
    "\n",
    "**Instructions:**\n",
    "- Focus exclusively on UCR Mechanical Engineering courses.\n",
    "- Use the provided catalog context to answer the question. If you don’t know, say so.\n",
    "- Give a detailed but consise response to the user\n",
    "\n",
    "**User Question:**\n",
