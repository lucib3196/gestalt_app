   "source": [
    "from openai import OpenAI\n",
    "from pydantic import BaseModel, Field\n",
    "from typing import Literal, List\n",
    "\n",
    "client = OpenAI()\n",
    "\n",
    "\n",
    "class Course(BaseModel):\n",
    "    course_id: str = Field(..., description=\"The course id of the class\")\n",
    "    name: str = Field(..., description=\"The title of the course\")\n",
    "    description: str = Field(..., description=\"A description of the course\")\n",
    "    level: Literal[\"lower\", \"upper\", \"graduate\"] = Field(\n",
    "        ...,\n",
    "        description=\"The level of the course wether it is a lower, upper or graduate level\",\n",
    "    )\n",
    "\n",
    "\n",
    "class Response(BaseModel):\n",
    "    courses: List[Course]\n",
    "\n",
    "\n",
    "response = client.beta.chat.completions.parse(\n",
    "    model=\"o3-2025-04-16\",\n",
    "    messages=[\n",
    "        {\"role\": \"system\", \"content\": \"Extract the course information\"},\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": prompt,\n",
    "        },\n",
    "    ],\n",
    "    response_format=Response,\n",
    ")"
   ]
  },
