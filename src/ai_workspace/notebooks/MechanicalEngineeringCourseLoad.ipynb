   "source": [
    "import asyncio\n",
    "\n",
    "async def main():\n",
    "    coros = [generate(course) for course in courses.choices[0].message.parsed.courses]\n",
    "    results = await asyncio.gather(*coros)\n",
    "    return results\n",
    "\n",
    "results = await main()"
   ]
